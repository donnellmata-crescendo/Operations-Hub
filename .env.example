# =============================================================================
# Operations Hub — environment configuration
# =============================================================================
# Copy to `.env.local` for local development. NEVER commit real secrets.
# All integration credentials are read SERVER-SIDE only (no NEXT_PUBLIC_ prefix)
# so they are never shipped to the browser.
# -----------------------------------------------------------------------------

# --- Atlassian (Confluence + Jira) ------------------------------------------
# A scoped API token from a service account. See docs/integrations.md.
ATLASSIAN_BASE_URL=https://crescendoai.atlassian.net
ATLASSIAN_EMAIL=ops-hub-svc@crescendo.ai
ATLASSIAN_API_TOKEN=

# Confluence space key that backs the hub content model
CONFLUENCE_SPACE_KEY=OPSHUB

# --- Data warehouse / BI (dashboards & metrics) -----------------------------
# Used server-side to fetch precomputed metric summaries + refresh timestamps.
WAREHOUSE_METRICS_URL=
WAREHOUSE_API_TOKEN=

# --- Grafana (live volume widgets, matching the PM benchmark) ----------------
GRAFANA_BASE_URL=
GRAFANA_API_TOKEN=

# --- Slack (announcements feed, optional) -----------------------------------
SLACK_BOT_TOKEN=
SLACK_ANNOUNCEMENTS_CHANNEL_ID=

# --- Cache / behaviour flags -------------------------------------------------
# Seconds to cache aggregated payloads server-side (near-real-time default).
HUB_CACHE_TTL_SECONDS=300
# When true, the app serves mock data and makes no external calls.
HUB_USE_MOCK_DATA=true
